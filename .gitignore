# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Test output
coverage/

# Logs
*.log
npm-debug.log*

# Environment files. LOWTIDE needs none; never commit one if it appears.
.env
.env.*
!.env.example
*.local

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Personal data exports must never land in the repo
lowtide-export*.json
lowtide-backup*.json

# The companion's private data never belongs here (it lives in ~/.lowtide)
*.sqlite
*.sqlite-*
*.db
*.db-*
companion.json
.lowtide/
